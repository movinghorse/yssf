<!-- Location Section -->
<section id="location" class="section-location animate-on-scroll">
  <div class="container">
    <h2 class="section-title">地理位置</h2>
    <div class="location-content">
      <div id="map" class="map-container">
        <div class="map-placeholder">
          <i class="fas fa-map-marked-alt"></i>
          <p>浙江省杭州市西湖区云栖路88号</p>
          <a href="https://maps.apple.com/?q=<%= config.theme_config.custom.address %>" target="_blank" rel="noopener" class="btn btn-secondary">查看地图</a>
        </div>
      </div>
      <div class="transportation-info">
        <h3>交通指南</h3>
        <div class="transport-tabs">
          <button class="tab-btn active" data-tab="self-drive">自驾</button>
          <button class="tab-btn" data-tab="train">高铁</button>
          <button class="tab-btn" data-tab="bus">公交</button>
        </div>
        <div class="tab-content">
          <div class="tab-pane active" data-tab="self-drive">
            <p><%= config.transport.self_drive.content %></p>
          </div>
          <div class="tab-pane" data-tab="train">
            <p><%= config.transport.train.content %></p>
          </div>
          <div class="tab-pane" data-tab="bus">
            <p><%= config.transport.bus.content %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
