<!-- Contact Section -->
<section id="contact" class="section-contact animate-on-scroll">
  <div class="container">
    <h2 class="section-title">联系我们</h2>
    <div class="contact-content">
      <div class="contact-info">
        <div class="info-item">
          <i class="fas fa-phone" aria-hidden="true"></i>
          <span><%= config.theme_config.custom.booking_phone %> / <%= config.theme_config.custom.booking_mobile %></span>
        </div>
        <div class="info-item">
          <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
          <span><%= config.theme_config.custom.address %></span>
        </div>
        <div class="info-item">
          <i class="fas fa-clock" aria-hidden="true"></i>
          <span><%= config.theme_config.custom.business_hours %></span>
        </div>
      </div>
      <div class="social-links">
        <a href="#" class="social-link" id="wechatLink" aria-label="微信"><i class="fab fa-weixin"></i></a>
        <a href="#" class="social-link" aria-label="微博"><i class="fab fa-weibo"></i></a>
        <a href="#" class="social-link" aria-label="小红书"><i class="fas fa-book-open"></i></a>
      </div>
    </div>
  </div>
</section>
