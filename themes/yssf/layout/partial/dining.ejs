<!-- Dining Section -->
<section id="dining" class="section-dining animate-on-scroll">
  <div class="container">
    <h2 class="section-title">餐饮活动</h2>
    <div class="dining-content">
      <div class="seasonal-menu">
        <h3>季节风味</h3>
        <div class="season-tabs">
          <% var seasons = ['spring', 'summer', 'autumn', 'winter']; %>
          <% var seasonLabels = {spring:'春', summer:'夏', autumn:'秋', winter:'冬'}; %>
          <% seasons.forEach(function(s, i) { %>
          <button class="season-tab<%= i === 0 ? ' active' : '' %>" data-season="<%= s %>"><%= seasonLabels[s] %></button>
          <% }) %>
        </div>
        <div class="menu-items">
          <% seasons.forEach(function(s, i) { %>
          <div class="menu-content<%= i === 0 ? ' active' : '' %>" data-season="<%= s %>">
            <% config.seasonal_menu[s].sections.forEach(function(sec) { %>
            <h4><%= sec.name %></h4>
            <ul class="dishes">
              <% sec.dishes.forEach(function(dish) { %>
              <li class="dish-item">
                <span class="dish-name"><%= dish.name %></span>
                <span class="dish-desc"><%= dish.desc %></span>
                <span class="dish-price"><%= dish.price %></span>
              </li>
              <% }) %>
            </ul>
            <% }) %>
          </div>
          <% }) %>
        </div>
        <p class="dining-note">为保证入住环境，会所一天只提供一桌预定饮食服务，请提前联系预约。</p>
      </div>
      <div class="activities">
        <h3>特色体验</h3>
        <div class="activity-timeline">
          <div class="timeline-item">
            <div class="timeline-icon"><i class="fas fa-coffee"></i></div>
            <div class="timeline-content">
              <h4>池塘品茶</h4>
              <p class="activity-date">全天候</p>
              <p>在听水轩前的亲水平台，捧一杯特级龙井，闻茶香、观茶尖、听水声。</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-icon"><i class="fas fa-music"></i></div>
            <div class="timeline-content">
              <h4>音乐与藏书</h4>
              <p class="activity-date">傍晚时分</p>
              <p>主人书房藏有数千张碟片与大量书籍，可自由选择与自己心情相配的音乐。</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-icon"><i class="fas fa-tree"></i></div>
            <div class="timeline-content">
              <h4>庭院烤火</h4>
              <p class="activity-date">秋冬时节</p>
              <p>在院中「烤太阳」、发呆、聊天；筛月阁壁炉噼啪作响，雨季尤为惬意。</p>
            </div>
          </div>
          <div class="timeline-item">
            <div class="timeline-icon"><i class="fas fa-mountain"></i></div>
            <div class="timeline-content">
              <h4>赏梅观雪</h4>
              <p class="activity-date">2 月 / 冬季</p>
              <p>2 月梅花盛开，玻璃墙外满院梅花映衬玉龙雪山；冬季院中可见雪山全貌。</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
