<!-- Rooms Section -->
<section id="rooms" class="section-rooms animate-on-scroll">
  <div class="container">
    <h2 class="section-title">客房展示</h2>
    <p class="section-desc">五栋纳西小楼，八间客房，每一间都有独立的室内外活动与喝茶空间。</p>
    <div class="room-filters">
      <button class="filter-btn active" data-filter="all">全部房型</button>
      <button class="filter-btn" data-filter="suite">套房</button>
      <button class="filter-btn" data-filter="view">景观房</button>
      <button class="filter-btn" data-filter="family">家庭房</button>
      <button class="filter-btn" data-filter="standard">标准房</button>
    </div>
    <div class="room-grid">
      <% rooms.forEach(function(room) { %>
      <div class="room-card" data-type="<%= room.type %>">
        <div class="card-front">
          <img src="<%- url_for(room.image) %>" alt="<%= config.title %><%= room.title %> - <%= room.description %>" loading="lazy">
          <div class="room-info">
            <h3><%= room.title %></h3>
            <p><%= room.area %> | <%= room.capacity %></p>
            <span class="price"><%= room.price_label %></span>
          </div>
        </div>
        <div class="card-back">
          <h3>设施详情</h3>
          <ul>
            <% room.amenities.forEach(function(a) { %>
            <li><i class="<%= a.icon %>"></i> <%= a.name %></li>
            <% }) %>
          </ul>
          <a href="<%- url_for(room.url) %>" class="btn btn-vr">查看详情</a>
        </div>
      </div>
      <% }) %>
    </div>
    <p class="rooms-note">预定价适用于除黄金周、节假日外的平日；加床 ¥50/晚。更多楼栋介绍见 <a href="<%- url_for('/客房介绍/') %>">客房介绍</a>。</p>
  </div>
</section>
