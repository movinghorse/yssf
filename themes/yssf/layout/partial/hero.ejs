<!-- Hero Section -->
<section class="hero">
  <div class="hero-slider">
    <div class="hero-slide active" style="background-image: url('<%- url_for("/images/hero-1.jpg") %>')"></div>
    <div class="hero-slide" style="background-image: url('<%- url_for("/images/hero-2.jpg") %>')"></div>
    <div class="hero-slide" style="background-image: url('<%- url_for("/images/hero-3.jpg") %>')"></div>
  </div>
  <div class="hero-content">
    <h1 class="fade-in"><%= config.title %></h1>
    <p class="slide-up"><%= config.subtitle %></p>
    <a href="#booking" class="btn btn-primary">立即预订</a>
  </div>
</section>
