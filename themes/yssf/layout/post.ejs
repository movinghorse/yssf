<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<%- partial('partial/head') %>
<body>
  <%- partial('partial/nav') %>
  <main class="post-main">
    <div class="container">
      <article class="post-content">
        <header class="post-header">
          <h1 class="post-title"><%= page.title %></h1>
          <div class="post-meta">
            <time datetime="<%= page.date.format('YYYY-MM-DD') %>">
              <i class="fas fa-calendar" aria-hidden="true"></i> <%= page.date.format('YYYY年MM月DD日') %>
            </time>
            <% if (page.categories && page.categories.length) { %>
            <span class="post-category">
              <i class="fas fa-folder" aria-hidden="true"></i>
              <% page.categories.forEach(function(cat) { %>
              <a href="<%- url_for(cat.path) %>"><%= cat.name %></a>
              <% }) %>
            </span>
            <% } %>
          </div>
        </header>
        <div class="post-body">
          <%- page.content %>
        </div>
        <% if (page.tags && page.tags.length) { %>
        <div class="post-tags">
          <% page.tags.forEach(function(tag) { %>
          <a href="<%- url_for(tag.path) %>" class="tag">#<%= tag.name %></a>
          <% }) %>
        </div>
        <% } %>
      </article>
    </div>
  </main>
  <%- partial('partial/footer') %>
  <%- partial('partial/customer-service') %>
</body>
</html>
